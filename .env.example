# CRE8TIVECOVE (C8C) CMS Environment Configuration Example
# Copy this file to .env and replace placeholder values for local development

# Database Connection (SQLite / PostgreSQL)
DATABASE_URL="file:./dev.db"

# NextAuth Authentication Security (Must be at least 32 characters long)
# Generate a secure key using: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32_MIN_32_CHARS"
NEXTAUTH_URL="http://localhost:3000"

# Initial Database Seed Credentials (Used by prisma/seed.ts)
# If left blank, a cryptographically secure random password will be generated and printed once
SEED_ADMIN_EMAIL="admin@cre8tivecove.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_INITIAL_SECURE_PASSWORD"
SEED_EDITOR_EMAIL="editor@cre8tivecove.com"
SEED_EDITOR_PASSWORD="CHANGE_ME_INITIAL_SECURE_PASSWORD"

# Optional Cloud Storage / CDN Assets
STORAGE_PROVIDER="local"
S3_BUCKET_NAME=""
S3_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
